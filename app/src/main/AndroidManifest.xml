<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="true" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- The app samples well under the 200 Hz this grants. Declaring it satisfies the health
         service-type prerequisite, so Android 14+ cannot refuse the service over a runtime
         permission the user declined. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Without this the accelerometer stops when the screen goes off, and the log has holes. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".StrideApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StrideSense">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".sensing.ActivitySensorService"
            android:exported="false"
            android:foregroundServiceType="health" />
    </application>
</manifest>
